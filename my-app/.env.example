# BarberCraft frontend environment variables.
# Copy this file to .env.local (or set these in your hosting dashboard, e.g. Vercel)
# and fill in your production URLs. Both default to local dev servers when unset.

# Main BarberCraft booking API (Render service: barbercraft-backend).
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# BarberCraft chatbot API (Render service: barbercraft-chatbot).
VITE_CHATBOT_API_URL=https://your-chatbot-service.onrender.com