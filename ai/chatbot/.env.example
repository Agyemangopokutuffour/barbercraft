# BarberCraft chatbot config — copy this file to .env and fill in your key.
# OPENROUTER_API_KEY: from https://openrouter.ai/keys
# OPENROUTER_MODEL: any OpenRouter model id; free/general picks verified live:
#   - google/gemma-4-31b-it:free        (general chat, 262K ctx)
#   - z-ai/glm-5.2:free                 (general chat + reasoning, 256K ctx)
#   - openrouter/free                   (auto-router, picks the best live free model)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Main BarberCraft backend that the chatbot's tools query.
BACKEND_URL=http://127.0.0.1:8001